{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Dark terminal identity with a single lime signal, shared by link.mzg.my.id, tmail.mzg.my.id and downloadin-ya.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.039,
          0.043,
          0.031
        ],
        "hex": "#0a0b08"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.961,
          0.961,
          0.961
        ],
        "hex": "#f5f5f5"
      }
    },
    "tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.706,
          1,
          0.169
        ],
        "hex": "#b4ff2b"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.659,
          0.659,
          0.659
        ],
        "hex": "#a8a8a8"
      }
    },
    "line": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.149,
          0.149,
          0.149
        ],
        "hex": "#262626"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.024,
          0.027,
          0.02
        ],
        "hex": "#060705"
      }
    },
    "on-primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.961,
          0.961,
          0.961
        ],
        "hex": "#f5f5f5"
      }
    },
    "on-tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.039,
          0.043,
          0.031
        ],
        "hex": "#0a0b08"
      }
    },
    "lime-faint": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.086,
          0.11,
          0.039
        ],
        "hex": "#161c0a"
      }
    },
    "lime-wash": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.145,
          0.196,
          0.055
        ],
        "hex": "#25320e"
      }
    },
    "lime-ghost": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.078,
          0.102,
          0.039
        ],
        "hex": "#141a0a"
      }
    },
    "error": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.42,
          0.42
        ],
        "hex": "#ff6b6b"
      }
    },
    "error-wash": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.137,
          0.071,
          0.059
        ],
        "hex": "#23120f"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xxl": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "section": {
      "$value": {
        "value": 64,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 9,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "full": {
      "$value": {
        "value": 9999,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "DotGothic16",
        "fontSize": {
          "value": 3,
          "unit": "rem"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0.08,
          "unit": "em"
        }
      }
    },
    "title": {
      "$type": "typography",
      "$value": {
        "fontFamily": "DotGothic16",
        "fontSize": {
          "value": 2,
          "unit": "rem"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0.08,
          "unit": "em"
        }
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Space Mono",
        "fontSize": {
          "value": 0.9,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "body-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Space Mono",
        "fontSize": {
          "value": 0.95,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "label-caps": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Space Mono",
        "fontSize": {
          "value": 0.75,
          "unit": "rem"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0.32,
          "unit": "em"
        }
      }
    },
    "metadata": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Space Mono",
        "fontSize": {
          "value": 0.78,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    }
  }
}
